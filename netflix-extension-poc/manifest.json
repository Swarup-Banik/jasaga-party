{
  "manifest_version": 3,
  "name": "JASAGA Netflix Sync",
  "version": "1.0.0",
  "description": "Synchronize your personal, authorized Netflix playback with friends in JASAGA Party watch rooms.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://jasaga.party/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JASAGA Netflix Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["page-observer.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://jasaga.party/*"
      ],
      "js": ["jasaga-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
