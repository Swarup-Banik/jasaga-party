# ========================================================
# JASAGA PARTY - Production Environment Template
# Copy this file to .env.local for local development,
# or add these variables to your production hosting provider
# (e.g., Vercel, Railway, Netlify, Render, AWS, Docker).
# ========================================================

# 1. Hyperbeam API Key (Virtual Cloud Browser Engine)
# Get an API key from https://hyperbeam.com/
# [SERVER-SIDE ONLY - Do NOT prefix with NEXT_PUBLIC_]
HYPERBEAM_API_KEY=

# 2. Supabase Realtime (Public Frontend Configuration)
# Get from Supabase Project Settings -> API
# [CLIENT-SIDE - Safe for browser consumption]
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# 3. Supabase Service Role Secret Key
# Get from Supabase Project Settings -> API -> Secret / Service Role Key
# [SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_ or expose to client]
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# 4. Optional: Default starting URL for new party rooms
NEXT_PUBLIC_DEFAULT_START_URL=https://www.youtube.com
